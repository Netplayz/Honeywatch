[Unit]
Description=HoneyWatch Honeypot
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=honeywatch
Group=honeywatch
WorkingDirectory=/opt/honeywatch
Environment=PYTHONPATH=/opt/honeywatch
ExecStart=/opt/honeywatch/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Config file written by install.sh
EnvironmentFile=-/etc/honeywatch/env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=true
RestrictRealtime=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
ReadWritePaths=/var/lib/honeypot /var/log/honeypot

[Install]
WantedBy=multi-user.target
